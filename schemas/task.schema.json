{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Embodied task",
  "type": "object",
  "required": ["id", "task_type", "actor", "goal"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "task_type": {"type": "string", "enum": ["tabletop", "indoor_navigation", "mobile_manipulation", "other"]},
    "actor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "base_position": {"$ref": "#/$defs/vector3"},
        "reach_radius": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": true
    },
    "manipulated_objects": {"type": "array", "items": {"type": "string"}},
    "goal": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 3,
      "maxItems": 3
    }
  },
  "additionalProperties": false
}

